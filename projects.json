{
  "defaults": {
    "github": {
      "site": "https://api.github.com",
      "per_repo_sample_days": 90
    },
    "jira": {
      "site": "https://celonis.atlassian.net",
      "api_version": "3",
      "done_statuses": [
        "Done",
        "Closed"
      ],
      "type_map": {
        "bug": [
          "Bug"
        ],
        "feature": [
          "Story",
          "Epic"
        ],
        "task": [
          "Task",
          "Sub-task"
        ]
      },
      "slice_by": "component",
      "noise_filter": {
        "enabled": true,
        "exclude_resolutions": [
          "Duplicate",
          "Won't Do",
          "Cannot Reproduce",
          "Invalid"
        ],
        "exclude_labels": [],
        "exclude_reporters": []
      },
      "security_filter": {
        "enabled": true,
        "security_project_keys": [
          "CBE"
        ],
        "issue_types": [
          "Vulnerability"
        ],
        "required_fields": [
          "Vulnerability Detected Date and Time",
          "Type of Vulnerability"
        ],
        "required_fields_mode": "any",
        "severity_field": "Risk Rating",
        "severity_levels": [
          "Critical",
          "High",
          "Moderate",
          "Low"
        ],
        "aging_field": "Vulnerability Detected Date and Time",
        "sla_critical_days": 14,
        "sla_high_days": 30,
        "product_scope_field": [
          "Product Assets",
          "Service Assets",
          "Squad Assets"
        ],
        "security_slice_by": "Service internal"
      },
      "customer_filter": {
        "enabled": true,
        "project_keys": [
          "CBE"
        ],
        "exclude_issue_types": [
          "Vulnerability"
        ],
        "severity_field": "priority",
        "severity_levels": [
          "Highest",
          "High",
          "Medium",
          "Low"
        ],
        "sla_p1_days": 3,
        "sla_p2_days": 14,
        "product_scope_field": [
          "Product Assets",
          "Service Assets",
          "Squad Assets"
        ],
        "slice_by": "Service internal"
      }
    }
  },
  "projects": [
    {
      "key": "TMT",
      "name": "Task Mining",
      "enabled": true,
      "product_scope_value": "task-mining",
      "datadog": {
        "site": "https://api.datadoghq.com"
      },
      "services": [
        {
          "name": "TM AI Service",
          "jira_scope": "TM AI Service",
          "security_scope": "task-mining-ai",
          "github": {
            "repos": [
              "celonis/task-mining-client"
            ]
          },
          "datadog": {
            "service_tags": [
              "service:task-mining-ai"
            ]
          }
        },
        {
          "name": "TM Chrome Extension",
          "jira_scope": "TM Chrome Extension",
          "security_scope": "task-mining-chrome-extension",
          "github": {
            "repos": [
              "celonis/task-mining-client"
            ]
          }
        },
        {
          "name": "TM Client",
          "jira_scope": "TM Client",
          "security_scope": "task-mining-client",
          "github": {
            "repos": [
              "celonis/task-mining-client"
            ]
          }
        },
        {
          "name": "TM Cloud Frontend",
          "jira_scope": "TM Cloud Frontend",
          "security_scope": "tm-cloud-frontend",
          "datadog": {
            "service_tags": [
              "service:ems-frontend_task-mining"
            ]
          }
        },
        {
          "name": "TM Cloud Service",
          "jira_scope": "TM Cloud Service",
          "security_scope": "tm-cloud-service"
        },
        {
          "name": "TM Config Editor",
          "jira_scope": "TM Config Editor",
          "security_scope": "tm-config-editor"
        },
        {
          "name": "TM Gateway",
          "jira_scope": "TM Gateway",
          "security_scope": "task-mining-gateway"
        },
        {
          "name": "TM PDD Export",
          "jira_scope": "TM PDD Export",
          "security_scope": "tm-pdd-export"
        },
        {
          "name": "TM Uploader",
          "jira_scope": "TM Uploader",
          "security_scope": "task-mining-uploader",
          "datadog": {
            "service_tags": [
              "service:task-mining-uploader"
            ]
          }
        },
        {
          "name": "TM Uploader Java",
          "jira_scope": "TM Uploader Java",
          "security_scope": "tm-image-collector",
          "datadog": {
            "service_tags": [
              "service:tm-image-collector"
            ]
          }
        }
      ],
      "unmatched_cbe_scopes": [
        {
          "name": "Cloud Task Mining",
          "security_scope": "cloud-task-mining"
        }
      ]
    }
  ]
}