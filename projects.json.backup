{
  "defaults": {
    "jira": {
      "site": "https://celonis.atlassian.net",
      "api_version": "3",
      "done_statuses": [
        "Done",
        "Closed"
      ],
      "type_map": {
        "bug": [
          "Bug"
        ],
        "feature": [
          "Story",
          "Epic"
        ],
        "task": [
          "Task",
          "Sub-task"
        ]
      },
      "slice_by": "component",
      "noise_filter": {
        "enabled": true,
        "exclude_resolutions": [
          "Duplicate",
          "Won't Do",
          "Cannot Reproduce",
          "Invalid"
        ],
        "exclude_labels": [],
        "exclude_reporters": []
      },
      "security_filter": {
        "enabled": true,
        "security_project_keys": [
          "CBE"
        ],
        "issue_types": [
          "Vulnerability"
        ],
        "required_fields": [
          "Vulnerability Detected Date and Time",
          "Type of Vulnerability"
        ],
        "required_fields_mode": "any",
        "severity_field": "Risk Rating",
        "severity_levels": [
          "Critical",
          "High",
          "Moderate",
          "Low"
        ],
        "aging_field": "Vulnerability Detected Date and Time",
        "sla_critical_days": 14,
        "sla_high_days": 30,
        "product_scope_field": [
          "Product Assets",
          "Service Assets",
          "Squad Assets"
        ],
        "security_slice_by": "Service internal"
      },
      "customer_filter": {
        "enabled": true,
        "project_keys": [
          "CBE"
        ],
        "exclude_issue_types": [
          "Vulnerability"
        ],
        "severity_field": "priority",
        "severity_levels": [
          "Highest",
          "High",
          "Medium",
          "Low"
        ],
        "sla_p1_days": 3,
        "sla_p2_days": 14,
        "product_scope_field": [
          "Product Assets",
          "Service Assets",
          "Squad Assets"
        ],
        "slice_by": "Service internal"
      }
    }
  },
  "projects": [
